generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Place {
  id           String       @id @default(cuid())
  name         String
  category     String
  address      String
  latitude     Float
  longitude    Float
  hours        String       @default("")
  description  String       @default("")
  facilities   String       @default("")
  hotWater     String       @default("unknown")
  toilet       String       @default("unknown")
  toiletType   String       @default("unknown")
  tagsJson     String       @default("[]")
  source       String       @default("admin")
  sourceUrl    String       @default("")
  reviewStatus String       @default("published")
  photos       PlacePhoto[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model PlacePhoto {
  id        String   @id @default(cuid())
  placeId   String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model ImportCandidate {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("")
  address      String   @default("")
  latitude     Float?
  longitude    Float?
  hours        String   @default("")
  description  String   @default("")
  facilities   String   @default("")
  hotWater     String   @default("unknown")
  toilet       String   @default("unknown")
  toiletType   String   @default("unknown")
  tagsJson     String   @default("[]")
  photoUrlsJson String  @default("[]")
  source       String
  sourceUrl    String
  rawJson      String   @default("{}")
  reviewStatus String   @default("pending")
  matchedPlaceId String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
