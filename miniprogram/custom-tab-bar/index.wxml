<view class="tabbar">
  <block wx:for="{{tabs}}" wx:key="pagePath">
    <view class="tab-item {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab">
      <image
        class="tab-icon"
        src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
        mode="aspectFit"
      />
      <text class="tab-text">{{item.text}}</text>
    </view>
  </block>
</view>
