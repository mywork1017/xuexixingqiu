.tabbar { align-items: flex-start; background: rgba(18, 18, 20, 0.98); border-top: 1rpx solid #322d3c; bottom: 0; box-sizing: border-box; display: flex; height: calc(136rpx + env(safe-area-inset-bottom)); left: 0; padding: 16rpx 0 env(safe-area-inset-bottom); position: fixed; right: 0; z-index: 50; }
.tab-item { align-items: center; color: #a0a0a0; display: flex; flex: 1; flex-direction: column; font-size: 24rpx; font-weight: 500; gap: 8rpx; justify-content: center; min-height: 96rpx; position: relative; transition: color 150ms cubic-bezier(.4, 0, 1, 1); }
.tab-item.active { color: #9b6df0; }
.tab-icon { height: 44rpx; width: 44rpx; }
.tab-text { line-height: 1.2; }

/* Purple-white theme */
.tabbar { background: rgba(255, 255, 255, 0.98); border-color: #e5e2e9; }
.tab-item { color: #65616b; }
.tab-item.active { color: #7d36ec; }
