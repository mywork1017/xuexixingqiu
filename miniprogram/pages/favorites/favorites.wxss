.mine-page { background: #18181b; box-sizing: border-box; min-height: 100vh; overflow: hidden; position: relative; }
.mine-backdrop { height: 440rpx; left: 0; opacity: 0.4; position: absolute; right: 0; top: 0; width: 100%; }
.mine-shade { background: rgba(18, 18, 20, 0.56); bottom: 0; left: 0; position: absolute; right: 0; top: 0; }
.custom-nav { align-items: center; background: rgba(18, 18, 20, 0.64); border-bottom: 1rpx solid rgba(50, 45, 60, 0.72); box-sizing: border-box; display: flex; justify-content: center; left: 0; position: absolute; right: 0; top: 0; z-index: 2; }
.nav-title { color: #ffffff; font-size: 40rpx; font-weight: 600; line-height: 1.2; }
.mine-scroll { box-sizing: border-box; height: 100vh; padding: 264rpx 32rpx calc(152rpx + env(safe-area-inset-bottom)); position: relative; z-index: 1; }
.account-panel { align-items: center; display: grid; gap: 24rpx; grid-template-columns: 112rpx minmax(0, 1fr) 80rpx; min-height: 128rpx; }
.avatar-wrap { align-items: center; background: #222225; border: 1rpx solid #322d3c; border-radius: 16rpx; display: flex; height: 104rpx; justify-content: center; overflow: hidden; width: 104rpx; }
.avatar { height: 104rpx; width: 104rpx; }
.avatar-text { color: #ffffff; font-size: 56rpx; line-height: 1; }
.account-main { min-width: 0; }
.nickname { color: #ffffff; font-size: 40rpx; font-weight: 600; line-height: 1.2; }
.login-state { align-items: center; background: rgba(125, 54, 236, 0.14); border: 1rpx solid rgba(125, 54, 236, 0.42); border-radius: 999rpx; color: #cbb5f5; display: inline-flex; font-size: 24rpx; gap: 8rpx; line-height: 1; margin-top: 12rpx; padding: 8rpx 16rpx; }
.check-dot { align-items: center; background: #7d36ec; border-radius: 50%; color: #ffffff; display: flex; font-size: 18rpx; font-weight: 700; height: 24rpx; justify-content: center; width: 24rpx; }
.logout-button { align-items: center; background: #222225; border: 1rpx solid #322d3c; border-radius: 12rpx; box-sizing: border-box; color: #a0a0a0; display: flex; font-size: 24rpx; justify-content: center; margin: 0; min-height: 64rpx; min-width: 80rpx; padding: 0 16rpx; }
.favorites-header { align-items: center; border-bottom: 1rpx solid #322d3c; display: flex; justify-content: space-between; margin: 48rpx 0 0; padding-bottom: 16rpx; }
.section-title { color: #ffffff; font-size: 32rpx; font-weight: 600; }
.favorite-count { color: #a0a0a0; font-size: 24rpx; }
.place-list { display: flex; flex-direction: column; }
.place-item { align-items: center; border-bottom: 1rpx solid #29272d; display: grid; gap: 16rpx; grid-template-columns: 72rpx minmax(0, 1fr) 16rpx; min-height: 136rpx; padding: 24rpx 0; }
.category-badge { align-items: center; background: #222225; border: 1rpx solid #322d3c; border-radius: 16rpx; display: flex; height: 72rpx; justify-content: center; overflow: hidden; width: 72rpx; }
.place-avatar { height: 56rpx; width: 56rpx; }
.item-main { min-width: 0; }
.item-name { color: #ffffff; display: inline; font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.item-category { background: rgba(125, 54, 236, 0.14); border: 1rpx solid rgba(125, 54, 236, 0.42); border-radius: 999rpx; color: #cbb5f5; display: inline-block; font-size: 22rpx; margin-left: 12rpx; padding: 2rpx 12rpx; vertical-align: 2rpx; }
.item-address, .item-hours { color: #a0a0a0; font-size: 24rpx; line-height: 1.5; margin-top: 6rpx; }
.item-arrow { color: #787878; font-size: 36rpx; }
.empty { align-items: center; border: 1rpx dashed #322d3c; border-radius: 16rpx; color: #a0a0a0; display: flex; flex-direction: column; margin-top: 24rpx; min-height: 192rpx; padding: 40rpx 24rpx; }
.empty-title { color: #ffffff; font-size: 32rpx; font-weight: 600; }
.empty-subtitle { color: #a0a0a0; font-size: 24rpx; margin-top: 8rpx; }

/* Purple-white theme */
.mine-page { background: #f7f7fa; }
.mine-backdrop { opacity: 0.22; }
.mine-shade { background: rgba(247, 247, 250, 0.58); }
.custom-nav { background: rgba(255, 255, 255, 0.72); border-color: rgba(229, 226, 233, 0.9); }
.nav-title, .nickname, .section-title, .item-name, .empty-title { color: #18181b; }
.avatar-wrap, .category-badge { background: #ffffff; border-color: #e5e2e9; }
.logout-button { background: #ffffff; border-color: #e5e2e9; color: #65616b; }
.favorites-header { border-color: #e5e2e9; }
.favorite-count, .item-address, .item-hours, .empty, .empty-subtitle { color: #65616b; }
.place-item { border-color: #e5e2e9; }
.item-arrow { color: #98959d; }
.empty { background: #ffffff; border-color: #d9d5df; }
