.favorites-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 0 40rpx;
}

.place-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 24rpx;
}

.place-item {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid rgba(31, 35, 40, 0.1);
  border-radius: 12rpx;
  display: flex;
  gap: 18rpx;
  padding: 24rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-kicker {
  color: #1f6feb;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.item-name {
  color: #1f2328;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.item-address,
.item-hours {
  color: #59636e;
  font-size: 25rpx;
  line-height: 1.45;
  margin-top: 8rpx;
}

.item-arrow {
  color: #8c959f;
  font-size: 48rpx;
}

.empty {
  color: #59636e;
  padding: 160rpx 0;
  text-align: center;
}
