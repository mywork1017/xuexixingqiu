.mine-page {
  background: #071112;
  box-sizing: border-box;
  min-height: 100vh;
  overflow: hidden;
  position: relative;
}

.mine-backdrop {
  height: 540rpx;
  left: 0;
  opacity: 0.48;
  position: absolute;
  right: 0;
  top: 0;
  width: 100%;
}

.mine-shade {
  background: linear-gradient(180deg, rgba(5, 10, 11, 0.42), rgba(5, 10, 11, 0.78) 26%, rgba(5, 10, 11, 0.94) 52%, #071112 72%, #071112 100%);
  bottom: 0;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
}

.custom-nav {
  align-items: center;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
  z-index: 2;
}

.nav-title {
  color: #f1dfbd;
  font-family: "Songti SC", "STSong", serif;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.2;
}

.mine-scroll {
  box-sizing: border-box;
  height: 100vh;
  padding: 304rpx 38rpx calc(170rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 1;
}

.account-panel {
  align-items: center;
  display: grid;
  gap: 28rpx;
  grid-template-columns: 136rpx 1fr 84rpx;
  min-height: 150rpx;
}

.avatar-wrap {
  align-items: center;
  background: radial-gradient(circle at 44% 36%, rgba(239, 218, 180, 0.22), transparent 38%), #15281c;
  border: 2rpx solid #e8c47d;
  border-radius: 50%;
  box-shadow: 0 0 36rpx rgba(232, 196, 125, 0.14);
  display: flex;
  height: 128rpx;
  justify-content: center;
  overflow: hidden;
  width: 128rpx;
}

.avatar {
  height: 128rpx;
  width: 128rpx;
}

.avatar-text {
  color: #f1dfbd;
  font-size: 70rpx;
  line-height: 1;
}

.account-main {
  min-width: 0;
}

.nickname {
  color: #f4ead8;
  font-family: "Songti SC", "STSong", serif;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.2;
}

.login-state {
  align-items: center;
  background: rgba(238, 230, 207, 0.18);
  border-radius: 999rpx;
  color: #dfd4c3;
  display: inline-flex;
  font-size: 27rpx;
  gap: 10rpx;
  line-height: 1;
  margin-top: 16rpx;
  padding: 11rpx 20rpx;
}

.check-dot {
  align-items: center;
  background: rgba(244, 236, 218, 0.86);
  border-radius: 50%;
  color: #1b241d;
  display: flex;
  font-size: 22rpx;
  font-weight: 800;
  height: 28rpx;
  justify-content: center;
  width: 28rpx;
}

.settings-button {
  align-items: center;
  background: transparent;
  color: #e8c47d;
  display: flex;
  flex-direction: column;
  font-size: 26rpx;
  gap: 8rpx;
  line-height: 1.2;
  margin: 0;
  padding: 0;
}

.settings-glyph {
  align-items: center;
  border: 3rpx solid #e8c47d;
  border-radius: 50%;
  display: flex;
  font-size: 34rpx;
  height: 56rpx;
  justify-content: center;
  line-height: 1;
  width: 56rpx;
}

.favorites-header {
  align-items: center;
  border-bottom: 1rpx solid rgba(232, 196, 125, 0.22);
  display: flex;
  justify-content: space-between;
  margin: 62rpx 0 14rpx;
  padding-bottom: 26rpx;
}

.section-title {
  align-items: center;
  color: #e8c47d;
  display: flex;
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 500;
  gap: 14rpx;
}

.section-title text {
  font-size: 48rpx;
}

.favorite-count {
  color: #d4b37a;
  font-size: 28rpx;
}

.place-list {
  display: flex;
  flex-direction: column;
}

.place-item {
  align-items: center;
  background: transparent;
  border-bottom: 1rpx solid rgba(232, 196, 125, 0.16);
  display: grid;
  gap: 22rpx;
  grid-template-columns: 96rpx 1fr 24rpx;
  min-height: 172rpx;
  padding: 30rpx 0;
}

.category-badge {
  align-items: center;
  border: 2rpx solid #e8c47d;
  border-radius: 50%;
  box-shadow: inset 0 0 24rpx rgba(0, 0, 0, 0.2);
  color: #f4dfb6;
  display: flex;
  font-size: 32rpx;
  font-weight: 800;
  height: 88rpx;
  justify-content: center;
  width: 88rpx;
}

.item-main {
  min-width: 0;
}

.item-name {
  color: #f4ead8;
  display: inline;
  font-family: "Songti SC", "STSong", serif;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.25;
}

.item-category {
  background: rgba(90, 125, 75, 0.28);
  border: 1rpx solid rgba(128, 161, 96, 0.36);
  border-radius: 16rpx;
  color: #d8e1c3;
  display: inline-block;
  font-size: 23rpx;
  margin-left: 14rpx;
  padding: 4rpx 14rpx;
  vertical-align: 4rpx;
}

.item-address,
.item-hours {
  color: #bdb2a2;
  font-size: 28rpx;
  line-height: 1.45;
  margin-top: 12rpx;
}

.item-arrow {
  color: #e8c47d;
  font-size: 54rpx;
}

.empty {
  align-items: center;
  border: 1rpx dashed rgba(232, 196, 125, 0.3);
  border-radius: 18rpx;
  color: #bdb2a2;
  display: flex;
  flex-direction: column;
  margin-top: 28rpx;
  min-height: 210rpx;
  padding: 48rpx 24rpx;
}

.empty-title {
  color: #f4ead8;
  font-family: "Songti SC", "STSong", serif;
  font-size: 36rpx;
  font-weight: 500;
}

.empty-subtitle {
  color: #bdb2a2;
  font-size: 26rpx;
  margin-top: 12rpx;
}
