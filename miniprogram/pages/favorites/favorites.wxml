<view class="page mine-page">
  <image class="mine-backdrop" src="/assets/backdrops/mine-library.png" mode="aspectFill" />
  <view class="mine-shade"></view>
  <view
    class="custom-nav"
    style="padding-top: {{navMetrics.statusBarHeight}}px; min-height: {{navMetrics.navBarHeight}}px;"
  >
    <view class="nav-title">我的</view>
  </view>

  <scroll-view class="mine-scroll" scroll-y>
    <view class="account-panel">
      <view class="avatar-wrap">
        <image class="avatar" wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill" />
        <text class="avatar-text" wx:else>●</text>
      </view>
      <view class="account-main">
        <view class="nickname">{{profile.nickName || '微信用户'}}</view>
        <view class="login-state"><text class="check-dot">✓</text>已登录 微信</view>
      </view>
      <button class="settings-button" bindtap="openSettings">
        <text class="settings-glyph">⚙</text>
        <text>设置</text>
      </button>
    </view>

    <view class="favorites-header">
      <view class="section-title"><text>☆</text>我的收藏</view>
      <view class="favorite-count">{{favoriteCount}} 个地点</view>
    </view>

    <view class="place-list" wx:if="{{favoritePlaces.length}}">
      <block wx:for="{{favoritePlaces}}" wx:key="id">
        <view class="place-item" data-id="{{item.id}}" bindtap="goToDetail">
          <view class="category-badge" style="background: {{item.categoryColor}};">{{item.categoryShortName}}</view>
          <view class="item-main">
            <view class="item-name">{{item.name}}</view>
            <view class="item-category">{{item.category}}</view>
            <view class="item-address">{{item.address}}</view>
            <view class="item-hours" wx:if="{{item.displayHours}}">◴ {{item.displayHours}}</view>
          </view>
          <view class="item-arrow">›</view>
        </view>
      </block>
    </view>

    <view class="empty" wx:else>
      <view class="empty-title">暂无收藏</view>
      <view class="empty-subtitle">还没有收藏地点</view>
    </view>
  </scroll-view>
</view>
