.list-page { background: #18181b; box-sizing: border-box; min-height: 100vh; padding: 32rpx 0 48rpx; }
.category-scroll { white-space: nowrap; width: 100%; }
.category-row { display: flex; gap: 16rpx; padding: 0 32rpx; }
.category-chip { background: #1d1d20; border: 1rpx solid #322d3c; border-radius: 12rpx; color: #a0a0a0; flex: 0 0 auto; font-size: 26rpx; font-weight: 500; height: 64rpx; line-height: 64rpx; margin: 0; min-width: 112rpx; padding: 0 24rpx; }
.category-chip.active { background: rgba(125, 54, 236, 0.14); border-color: #7d36ec; box-shadow: inset 0 -3rpx 0 #7d36ec; color: #ffffff; }
.count-row { color: #a0a0a0; font-size: 24rpx; margin: 24rpx 32rpx 16rpx; }
.place-list { display: flex; flex-direction: column; gap: 16rpx; padding: 0 32rpx; }
.place-item { align-items: center; background: #1d1d20; border: 1rpx solid #322d3c; border-radius: 16rpx; display: flex; gap: 16rpx; min-height: 136rpx; padding: 24rpx; }
.item-main { flex: 1; min-width: 0; }
.item-kicker { color: #9b6df0; font-size: 22rpx; font-weight: 600; margin-bottom: 4rpx; }
.item-name { color: #ffffff; font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.item-address, .item-hours { color: #a0a0a0; font-size: 24rpx; line-height: 1.5; margin-top: 4rpx; }
.item-arrow { color: #787878; font-size: 40rpx; }
.empty { color: #a0a0a0; padding: 120rpx 0; text-align: center; }

/* Purple-white theme */
.list-page { background: #f7f7fa; }
.category-chip, .place-item { background: #ffffff; border-color: #e5e2e9; }
.category-chip { color: #65616b; }
.category-chip.active { background: #f0e9fc; border-color: #7d36ec; color: #6b24d6; }
.count-row, .item-address, .item-hours, .empty { color: #65616b; }
.item-name { color: #18181b; }
.item-kicker { color: #7d36ec; }
.item-arrow { color: #98959d; }
