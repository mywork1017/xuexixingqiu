.detail-page { background: #f2f2f7; min-height: 100vh; overflow: hidden; }
.custom-nav { background: rgba(242, 242, 247, 0.94); border-bottom: 1rpx solid rgba(60, 60, 67, 0.14); box-sizing: border-box; left: 0; position: fixed; right: 0; top: 0; z-index: 20; }
.nav-content { left: 0; position: absolute; right: 0; }
.back-button { align-items: center; background: transparent; border: 0; box-sizing: border-box; color: #000000; display: flex; font-size: 64rpx; height: 88rpx; justify-content: center; left: 20rpx; line-height: 1; margin: 0; min-height: 88rpx; min-width: 88rpx; padding: 0 0 6rpx; position: absolute; top: 50%; transform: translateY(-50%); width: 88rpx; z-index: 2; }
.nav-title { color: #1c1c1e; font-size: 34rpx; font-weight: 600; left: 0; line-height: 1.2; padding: 0 120rpx; pointer-events: none; position: absolute; right: 0; text-align: center; top: 50%; transform: translateY(-50%); }
.detail-scroll { box-sizing: border-box; height: 100vh; padding: 0 32rpx; }
.photo-panel { border-radius: 24rpx; height: 622rpx; margin-top: 32rpx; overflow: hidden; }
.photo-swiper, .cover-photo { background: #e5e5ea; height: 622rpx; width: 100%; }
.hero { align-items: center; display: flex; gap: 24rpx; justify-content: flex-start; margin-bottom: 24rpx; padding: 40rpx 8rpx 0; }
.hero-main { flex: 1; min-width: 0; text-align: left; }
.title { color: #1c1c1e; font-size: 48rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.2; text-align: left; }
.action-row { display: grid; gap: 16rpx; grid-template-columns: minmax(0, 1fr); margin-top: 24rpx; min-width: 0; width: 100%; }
.action-button { align-items: center; border-radius: 20rpx; box-sizing: border-box; display: flex; font-size: 28rpx; font-weight: 600; gap: 8rpx; justify-content: center; margin: 0; min-height: 88rpx; min-width: 0; overflow: hidden; padding: 0 20rpx; white-space: nowrap; width: 100%; }
.detail-action-icon { flex: 0 0 auto; height: 28rpx; width: 28rpx; }
.section { margin-bottom: 24rpx; }
.detail-card { background: #ffffff; border: 1rpx solid rgba(60, 60, 67, 0.10); border-radius: 32rpx; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04); padding: 32rpx; }
.map-section { position: relative; }
.section-title { color: #1c1c1e; font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; text-align: left; }
.detail-map-shell { border: 0; border-radius: 24rpx; height: 280rpx; overflow: hidden; position: relative; width: 100%; }
.detail-map { height: 100%; pointer-events: none; width: 100%; }
.map-address { color: #636366; font-size: 26rpx; line-height: 1.5; margin-bottom: 24rpx; text-align: left; }
.detail-scroll { scrollbar-width: none; }
.detail-scroll::-webkit-scrollbar { display: none; height: 0; width: 0; }
.section-body { color: #3a3a3c; font-size: 28rpx; line-height: 1.65; text-align: left; }
.nearby-header { align-items: center; display: flex; justify-content: flex-start; }
.nearby-category-scroll { margin: 0 0 8rpx; width: 100%; }
.nearby-category-row { background: #e9e9eb; border-radius: 20rpx; box-sizing: border-box; display: flex; gap: 4rpx; padding: 4rpx; width: 100%; }
.nearby-category-chip { align-items: center; background: transparent; border: 0; border-radius: 16rpx; color: #636366; display: flex; flex: 1 1 0; font-size: 26rpx; font-weight: 500; gap: 8rpx; height: 64rpx; justify-content: center; line-height: 64rpx; margin: 0; max-width: none; min-width: 0; padding: 0 8rpx; }
.nearby-category-chip.active { background: #ffffff; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.10); color: #000000; }
.category-dot { border-radius: 50%; box-sizing: border-box; flex: 0 0 24rpx; height: 24rpx; width: 24rpx; }
.category-dot.solid { background: #000000; border: 1px solid #ffffff; }
.category-dot.inverse { background: #ffffff; border: 1px solid #000000; }
.nearby-list { display: flex; flex-direction: column; margin-top: 16rpx; }
.nearby-item { align-items: center; border-bottom: 1rpx solid rgba(60, 60, 67, 0.14); display: grid; gap: 16rpx; grid-template-columns: minmax(0, 1fr) 104rpx 16rpx; min-height: 112rpx; padding: 20rpx 0; }
.nearby-item:last-child { border-bottom: 0; }
.nearby-main { min-width: 0; }
.nearby-name { color: #1c1c1e; font-size: 30rpx; font-weight: 500; line-height: 1.4; }
.nearby-address { color: #636366; font-size: 24rpx; line-height: 1.5; margin-top: 4rpx; }
.nearby-distance { color: #8e8e93; font-size: 24rpx; text-align: right; }
.item-arrow { color: #8e8e93; font-size: 36rpx; }
.nearby-empty { color: #8e8e93; font-size: 26rpx; padding: 32rpx 0 8rpx; text-align: center; }
