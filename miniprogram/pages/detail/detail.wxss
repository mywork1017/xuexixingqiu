.detail-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
}

.photo-strip {
  margin: 0 -24rpx 22rpx;
  white-space: nowrap;
  width: calc(100% + 48rpx);
}

.photo-row {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
}

.place-photo {
  background: #eaeef2;
  border-radius: 12rpx;
  flex: 0 0 auto;
  height: 260rpx;
  width: 420rpx;
}

.hero {
  background: #ffffff;
  border: 1rpx solid rgba(31, 35, 40, 0.1);
  border-radius: 16rpx;
  padding: 32rpx;
}

.category {
  color: #1f6feb;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.title {
  color: #1f2328;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.22;
}

.address {
  color: #59636e;
  font-size: 28rpx;
  line-height: 1.45;
  margin-top: 16rpx;
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.action-button {
  flex: 1;
}

.section {
  background: #ffffff;
  border: 1rpx solid rgba(31, 35, 40, 0.1);
  border-radius: 16rpx;
  margin-top: 18rpx;
  padding: 28rpx;
}

.map-section {
  overflow: hidden;
}

.section-title {
  color: #1f2328;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.detail-map {
  border-radius: 12rpx;
  height: 320rpx;
  margin-top: 14rpx;
  overflow: hidden;
  width: 100%;
}

.section-body {
  color: #59636e;
  font-size: 28rpx;
  line-height: 1.55;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  background: #eef4ff;
  border-radius: 999rpx;
  color: #1f6feb;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
}

.nearby-header {
  align-items: center;
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
}

.nearby-subtitle {
  color: #8c959f;
  font-size: 24rpx;
  margin-top: -4rpx;
}

.nearby-toggle {
  background: #ffffff;
  border: 1rpx solid rgba(31, 35, 40, 0.14);
  border-radius: 999rpx;
  color: #1f2328;
  font-size: 24rpx;
  line-height: 56rpx;
  margin: 0;
  padding: 0 24rpx;
}

.nearby-category-scroll {
  margin: 18rpx -28rpx 0;
  white-space: nowrap;
  width: calc(100% + 56rpx);
}

.nearby-category-row {
  display: flex;
  gap: 10rpx;
  padding: 0 28rpx;
}

.nearby-category-chip {
  align-items: center;
  background: rgba(255, 255, 255, 0.64);
  border: 1rpx solid rgba(31, 35, 40, 0.08);
  border-radius: 999rpx;
  color: #8c959f;
  display: flex;
  flex: 0 0 auto;
  font-size: 23rpx;
  gap: 8rpx;
  height: 52rpx;
  line-height: 52rpx;
  margin: 0;
  padding: 0 18rpx;
}

.nearby-category-chip.active {
  background: #ffffff;
  border-color: #1677ff;
  color: #1f2328;
  font-weight: 600;
}

.category-dot {
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx rgba(31, 35, 40, 0.16);
  height: 14rpx;
  opacity: 0.35;
  width: 14rpx;
}

.nearby-category-chip.active .category-dot {
  opacity: 1;
}

.nearby-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.nearby-item {
  align-items: center;
  border-top: 1rpx solid rgba(31, 35, 40, 0.08);
  display: flex;
  gap: 16rpx;
  padding-top: 18rpx;
}

.nearby-main {
  flex: 1;
  min-width: 0;
}

.nearby-name {
  color: #1f2328;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.nearby-meta,
.nearby-address {
  color: #59636e;
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: 6rpx;
}

.item-arrow {
  color: #8c959f;
  font-size: 42rpx;
}

.nearby-empty {
  color: #8c959f;
  font-size: 26rpx;
  padding: 32rpx 0 8rpx;
  text-align: center;
}
