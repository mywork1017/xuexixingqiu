.detail-page { background: #18181b; min-height: 100vh; overflow: hidden; }
.custom-nav { background: rgba(18, 18, 20, 0.98); border-bottom: 1rpx solid #29272d; box-sizing: border-box; left: 0; position: fixed; right: 0; top: 0; z-index: 20; }
.nav-content { left: 0; position: absolute; right: 0; }
.back-button { align-items: center; background: transparent; border: 0; box-sizing: border-box; color: #ffffff; display: flex; font-size: 48rpx; height: 80rpx; justify-content: center; left: 24rpx; line-height: 1; margin: 0; min-height: 80rpx; min-width: 80rpx; padding: 0 0 4rpx; position: absolute; top: 50%; transform: translateY(-50%); width: 80rpx; z-index: 2; }
.nav-title { color: #ffffff; font-size: 36rpx; font-weight: 600; left: 0; line-height: 1.2; padding: 0 120rpx; pointer-events: none; position: absolute; right: 0; text-align: center; top: 50%; transform: translateY(-50%); }
.detail-scroll { box-sizing: border-box; height: 100vh; padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.photo-panel { height: 288rpx; margin: 0 -32rpx 32rpx; overflow: hidden; }
.photo-swiper, .cover-photo { background: #1d1d20; height: 288rpx; width: 100%; }
.hero { align-items: center; display: flex; gap: 24rpx; margin-bottom: 32rpx; }
.place-icon { align-items: center; display: flex; flex: 0 0 auto; height: 104rpx; justify-content: center; width: 104rpx; }
.place-avatar { height: 104rpx; width: 104rpx; }
.hero-main { flex: 1; min-width: 0; }
.title { color: #ffffff; font-size: 44rpx; font-weight: 600; line-height: 1.2; }
.address { align-items: center; color: #a0a0a0; display: grid; font-size: 26rpx; gap: 12rpx; grid-template-columns: 28rpx minmax(0, 1fr); line-height: 1.5; margin-top: 12rpx; }
.action-row { display: grid; gap: 16rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: 48rpx; min-width: 0; width: 100%; }
.action-button { align-items: center; border-radius: 12rpx; box-sizing: border-box; display: flex; font-size: 28rpx; font-weight: 500; gap: 8rpx; justify-content: center; margin: 0; min-height: 80rpx; min-width: 0; overflow: hidden; padding: 0 16rpx; white-space: nowrap; width: 100%; }
.detail-action-icon { flex: 0 0 auto; height: 28rpx; width: 28rpx; }
.action-button.active { background: rgba(125, 54, 236, 0.14); border-color: #7d36ec; color: #ffffff; }
.section { margin-bottom: 48rpx; padding: 0; }
.map-section { overflow: hidden; position: relative; }
.section-title { color: #ffffff; font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.detail-map { border: 1rpx solid #322d3c; border-radius: 12rpx; height: 184rpx; overflow: hidden; width: 100%; }
.section-body { color: #a0a0a0; font-size: 28rpx; line-height: 1.5; }
.icon-body { align-items: center; display: grid; gap: 12rpx; grid-template-columns: 28rpx minmax(0, 1fr); }
.detail-meta-icon { height: 28rpx; opacity: 0.72; width: 28rpx; }
.tag-row { display: flex; flex-wrap: wrap; gap: 8rpx; }
.tag { background: #222225; border: 1rpx solid #322d3c; border-radius: 999rpx; color: #a0a0a0; font-size: 24rpx; padding: 6rpx 16rpx; }
.nearby-header { align-items: center; display: flex; justify-content: space-between; }
.nearby-category-scroll { margin: 0 -32rpx 8rpx; white-space: nowrap; width: calc(100% + 64rpx); }
.nearby-category-row { display: flex; gap: 16rpx; padding: 0 32rpx; }
.nearby-category-chip { align-items: center; background: #1d1d20; border: 1rpx solid #322d3c; border-radius: 12rpx; color: #a0a0a0; display: flex; flex: 0 0 auto; font-size: 26rpx; font-weight: 500; gap: 8rpx; height: 64rpx; justify-content: center; line-height: 64rpx; margin: 0; max-width: none; min-width: 0; padding: 0 24rpx; }
.nearby-category-chip.active { background: rgba(125, 54, 236, 0.14); border-color: #7d36ec; box-shadow: inset 0 -3rpx 0 #7d36ec; color: #ffffff; }
.category-dot { border-radius: 50%; flex: 0 0 12rpx; height: 12rpx; width: 12rpx; }
.nearby-list { display: flex; flex-direction: column; margin-top: 16rpx; }
.nearby-item { align-items: center; border-bottom: 1rpx solid #29272d; display: grid; gap: 16rpx; grid-template-columns: 64rpx minmax(0, 1fr) 104rpx 16rpx; min-height: 112rpx; padding: 16rpx 0; }
.nearby-icon { align-items: center; display: flex; height: 64rpx; justify-content: center; width: 64rpx; }
.nearby-avatar { height: 64rpx; width: 64rpx; }
.nearby-main { min-width: 0; }
.nearby-name { color: #ffffff; font-size: 30rpx; font-weight: 500; line-height: 1.4; }
.nearby-address { color: #a0a0a0; font-size: 24rpx; line-height: 1.5; margin-top: 4rpx; }
.nearby-distance { color: #a0a0a0; font-size: 24rpx; text-align: right; }
.item-arrow { color: #787878; font-size: 36rpx; }
.nearby-empty { color: #a0a0a0; font-size: 26rpx; padding: 32rpx 0 8rpx; text-align: center; }

/* Purple-white theme */
.detail-page { background: #f7f7fa; }
.custom-nav { background: rgba(255, 255, 255, 0.98); border-color: #e5e2e9; }
.back-button, .nav-title, .title, .section-title, .nearby-name { color: #18181b; }
.address, .section-body, .nearby-address, .nearby-distance, .nearby-empty { color: #65616b; }
.action-button.secondary-button { background: #ffffff; border-color: #d9d5df; color: #18181b; }
.action-button.active { background: #f0e9fc; border-color: #7d36ec; color: #6b24d6; }
.detail-map { border-color: #e5e2e9; }
.tag { background: #ffffff; border-color: #e5e2e9; color: #65616b; }
.nearby-category-chip { background: #ffffff; border-color: #e5e2e9; color: #65616b; }
.nearby-category-chip.active { background: #f0e9fc; border-color: #7d36ec; color: #6b24d6; }
.nearby-item { border-color: #efedf2; }
.item-arrow { color: #98959d; }
