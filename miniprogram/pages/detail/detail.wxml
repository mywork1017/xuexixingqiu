<view class="page detail-page" wx:if="{{place}}">
  <view
    class="custom-nav"
    style="height: {{navMetrics.topOffset}}px;"
  >
    <view
      class="nav-content"
      style="top: {{navMetrics.statusBarHeight}}px; height: {{navMetrics.navBarHeight}}px;"
    >
      <view class="back-button" aria-label="返回" bindtap="goBack">‹</view>
      <view class="nav-title">地点详情</view>
    </view>
  </view>

  <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="padding-top: {{navMetrics.topOffset}}px;">
    <view class="hero">
      <view class="hero-main">
        <view class="title">{{place.name}}</view>
      </view>
    </view>

    <view class="section detail-card map-section">
      <view class="map-address">{{place.displayAddress}}</view>
      <view class="detail-map-shell" aria-role="button" aria-label="打开导航" bindtap="openLocation">
        <map
          class="detail-map"
          latitude="{{place.latitude}}"
          longitude="{{place.longitude}}"
          markers="{{detailMapMarkers}}"
          scale="16"
          enable-scroll="{{false}}"
          enable-zoom="{{false}}"
          enable-rotate="{{false}}"
          enable-overlooking="{{false}}"
        ></map>
      </view>
      <view class="action-row">
        <view class="primary-button action-button" bindtap="openLocation">
          <image class="detail-action-icon" src="/assets/actions/detail/xiangqing_caozuo_dh.png" mode="aspectFit" />
          <text>{{place.navigationLabel}}</text>
        </view>
      </view>
    </view>

    <view class="section detail-card info-card">
      <view class="section-title">开放时间</view>
      <view class="section-body">{{place.displayHours}}</view>
    </view>

    <view class="section detail-card info-card">
      <view class="section-title">简介</view>
      <view class="section-body">{{place.displayDescription}}</view>
      <view class="photo-panel" wx:if="{{place.displayPhotos.length}}">
        <swiper
          wx:if="{{place.displayPhotos.length > 1}}"
          class="photo-swiper"
          circular
          indicator-dots="{{true}}"
          indicator-color="rgba(255, 255, 255, 0.48)"
          indicator-active-color="#ffffff"
          autoplay="{{true}}"
          interval="5000"
          duration="420"
        >
          <block wx:for="{{place.displayPhotos}}" wx:key="*this">
            <swiper-item>
              <image class="cover-photo" src="{{item}}" mode="aspectFill" lazy-load="{{false}}" fade-in="{{true}}" />
            </swiper-item>
          </block>
        </swiper>
        <image wx:else class="cover-photo" src="{{place.displayPhotos[0]}}" mode="aspectFill" lazy-load="{{false}}" fade-in="{{true}}" />
      </view>
    </view>

    <view class="section detail-card nearby-card">
      <view class="nearby-header">
        <view class="section-title">周边 2 公里</view>
      </view>

      <view class="nearby-category-scroll">
        <view class="nearby-category-row">
          <block wx:for="{{nearbyCategoryTabs}}" wx:key="name">
            <button
              class="nearby-category-chip {{item.active ? 'active' : ''}}"
              data-category="{{item.name}}"
              bindtap="toggleNearbyCategory"
            >
              <text wx:if="{{item.name !== '全部'}}" class="category-dot {{item.markerStyle}}"></text>
              <text>{{item.name}}</text>
            </button>
          </block>
        </view>
      </view>

      <view class="nearby-list" wx:if="{{nearbyPlaces.length}}">
        <block wx:for="{{nearbyPlaces}}" wx:key="id">
          <view class="nearby-item" data-id="{{item.id}}" bindtap="goToDetail">
            <view class="nearby-main">
              <view class="nearby-name">{{item.name}}</view>
              <view class="nearby-address">{{item.address}}</view>
            </view>
            <view class="nearby-distance">{{item.distanceText}}</view>
            <view class="item-arrow">›</view>
          </view>
        </block>
      </view>

      <view class="nearby-empty" wx:else>附近暂无匹配地点</view>
    </view>
  </scroll-view>
</view>
