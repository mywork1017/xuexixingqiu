<view class="page map-page">
  <map
    id="studyMap"
    class="study-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    show-location
    bindtap="onMapTap"
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
  />

  <view class="top-panel">
    <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-row">
        <block wx:for="{{categoryTabs}}" wx:key="name">
          <button
            class="category-chip {{item.active ? 'active' : ''}}"
            data-category="{{item.name}}"
            bindtap="toggleCategory"
          >
            <text class="category-dot" style="background: {{item.color}};"></text>
            <text>{{item.name}}</text>
          </button>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="map-actions">
    <button class="location-button" aria-label="定位" bindtap="moveToUserLocation">
      <text class="location-glyph">◎</text>
    </button>
  </view>

  <view class="bottom-sheet" wx:if="{{selectedPlace}}">
    <view class="sheet-topline">
      <view class="sheet-kicker">{{selectedPlace.category}}</view>
      <button class="favorite-button {{selectedPlace.isFavorite ? 'active' : ''}}" bindtap="toggleFavorite">
        {{selectedPlace.isFavorite ? '已收藏' : '收藏'}}
      </button>
    </view>
    <view class="sheet-title">{{selectedPlace.name}}</view>
    <view class="sheet-address">{{selectedPlace.address || '地址待补充'}}</view>
    <view class="sheet-meta" wx:if="{{selectedPlace.hours}}">开放时间：{{selectedPlace.hours}}</view>
    <view class="sheet-summary" wx:if="{{selectedPlace.description}}">{{selectedPlace.description}}</view>
    <view class="sheet-tags">
      <block wx:for="{{selectedPlace.tags}}" wx:key="*this">
        <text class="tag">{{item}}</text>
      </block>
    </view>
    <view class="sheet-actions">
      <button class="primary-button sheet-action" bindtap="openLocation">导航</button>
      <button class="secondary-button sheet-action" bindtap="goToDetail">详情</button>
    </view>
  </view>

</view>
