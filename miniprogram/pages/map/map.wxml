<view class="page map-page">
  <map
    id="studyMap"
    class="study-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    enable-3D="{{false}}"
    enable-building="{{false}}"
    enable-poi="{{true}}"
    enable-traffic="{{false}}"
    bindtap="onMapTap"
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
  />

  <view class="map-header-bg" style="height: {{navMetrics.headerHeight}}px;"></view>

  <view
    class="custom-nav"
    style="padding-top: {{navMetrics.statusBarHeight}}px; min-height: {{navMetrics.navBarHeight}}px; transform: translateY({{navMetrics.contentOffset}}px);"
  >
    <view class="nav-title" style="padding-right: {{navMetrics.capsuleReserve}}px;">通仔的学习星球</view>
  </view>

  <view class="top-panel" style="top: {{navMetrics.filterTop}}px;">
    <view class="category-scroll">
      <view class="category-row">
        <block wx:for="{{categoryTabs}}" wx:key="name">
          <button
            class="category-chip {{item.active ? 'active' : ''}}"
            data-category="{{item.name}}"
            bindtap="toggleCategory"
          >
            <text wx:if="{{item.name !== '全部'}}" class="category-dot {{item.markerStyle}}"></text>
            <text>{{item.name}}</text>
          </button>
        </block>
      </view>
    </view>
  </view>

  <view class="load-tip" wx:if="{{loadError}}">{{loadError}}</view>
  <view class="empty-tip" wx:if="{{noResultsInView}}">附近没有结果</view>

  <view class="map-actions {{selectedPlace ? 'with-sheet' : ''}}">
    <view class="location-button" aria-label="定位" bindtap="moveToUserLocation">
      <image class="location-icon" src="/assets/actions/map/ditu_ditu_dw.png" mode="aspectFit" />
    </view>
  </view>

  <view class="bottom-sheet" wx:if="{{selectedPlace}}">
    <swiper
      class="place-card-swiper"
      current="{{selectedPlaceIndex}}"
      circular="{{displayPlaces.length > 1}}"
      disable-touch="{{displayPlaces.length <= 1}}"
      duration="{{cardSwipeDuration}}"
      bindchange="onPlaceCardChange"
    >
      <block wx:for="{{displayPlaces}}" wx:key="id" wx:for-item="place">
        <swiper-item>
          <view class="sheet-card" data-id="{{place.id}}" bindtap="goToDetail">
            <view class="sheet-main">
              <view class="sheet-content">
                <view class="sheet-title">{{place.name}}</view>
                <view class="sheet-meta-row address-row">
                  <image class="sheet-meta-icon" src="/assets/actions/map/ditu_kapian_dz.png" mode="aspectFit" />
                  <text class="sheet-meta-text">{{place.displayAddress}}</text>
                </view>
                <view class="sheet-meta-row">
                  <image class="sheet-meta-icon" src="/assets/actions/map/ditu_kapian_sj.png" mode="aspectFit" />
                  <text class="sheet-meta-text">{{place.displayHours}}</text>
                </view>
              </view>
            </view>
            <view class="sheet-divider"></view>
            <view class="sheet-actions">
              <view class="primary-button sheet-action" data-id="{{place.id}}" catchtap="openLocation">
                <image class="sheet-action-icon" src="/assets/actions/map/ditu_kapian_dh.png" mode="aspectFit" />
                <text>{{place.distanceText || place.navigationLabel}}</text>
              </view>
              <view class="secondary-button sheet-action" data-id="{{place.id}}" catchtap="goToDetail">
                <image class="sheet-action-icon" src="/assets/actions/map/ditu_kapian_xq.png" mode="aspectFit" />
                <text>详情</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>
  </view>
</view>
