.map-page { background: #f2f2f7; height: 100vh; overflow: hidden; position: relative; }
.study-map { height: 100vh; width: 100vw; }
.map-header-bg { background: #ffffff; border-bottom: 1rpx solid rgba(60, 60, 67, 0.14); left: 0; pointer-events: none; position: absolute; right: 0; top: 0; z-index: 2; }
.custom-nav { align-items: center; box-sizing: border-box; display: flex; justify-content: flex-start; left: 0; padding-left: 32rpx; position: absolute; right: 0; top: 0; z-index: 3; }
.nav-title { color: #1c1c1e; font-size: 40rpx; font-weight: 600; line-height: 1.2; text-align: left; }
.top-panel { left: 0; padding: 0; position: absolute; right: 0; z-index: 3; }
.category-scroll { box-sizing: border-box; width: 100%; }
.category-row { box-sizing: border-box; display: flex; gap: 16rpx; padding: 0 32rpx; width: 100%; }
.category-chip { align-items: center; background: #ffffff; border: 1rpx solid rgba(60, 60, 67, 0.14); border-radius: 12rpx; color: #636366; display: flex; flex: 1 1 0; font-size: 26rpx; font-weight: 500; gap: 8rpx; height: 64rpx; justify-content: center; line-height: 64rpx; margin: 0; max-width: none; min-width: 0; padding: 0 8rpx; }
.category-chip.active { background: #f0f0f0; border-color: #000000; box-shadow: inset 0 -3rpx 0 #000000; color: #000000; }
.category-dot { border-radius: 50%; box-sizing: border-box; flex: 0 0 24rpx; height: 24rpx; width: 24rpx; }
.category-dot.solid { background: #000000; border: 1px solid #ffffff; }
.category-dot.inverse { background: #ffffff; border: 1px solid #000000; }
.load-tip, .empty-tip { background: rgba(255, 255, 255, 0.96); border: 1rpx solid #d1d1d6; border-radius: 12rpx; color: #636366; font-size: 24rpx; padding: 12rpx 20rpx; position: absolute; z-index: 4; }
.load-tip { left: 32rpx; top: 224rpx; }
.empty-tip { left: 50%; top: 50%; transform: translate(-50%, -50%); }
.map-actions { bottom: calc(48rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 16rpx; position: absolute; right: 32rpx; transition: bottom 200ms cubic-bezier(.22, 1, .36, 1); }
.map-actions.with-sheet { bottom: calc(366rpx + env(safe-area-inset-bottom)); right: 16rpx; }
.location-button { align-items: center; background: rgba(255, 255, 255, 0.96); border: 1rpx solid rgba(60, 60, 67, 0.14); border-radius: 24rpx; box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.10); box-sizing: border-box; display: flex; height: 80rpx; justify-content: center; width: 80rpx; }
.location-icon { height: 48rpx; opacity: 0.9; width: 48rpx; }
.bottom-sheet { bottom: calc(16rpx + env(safe-area-inset-bottom)); height: 326rpx; left: 8rpx; position: absolute; right: 8rpx; }
.place-card-swiper { height: 100%; width: 100%; }
.sheet-card { background: #ffffff; border: 1rpx solid rgba(60, 60, 67, 0.10); border-radius: 32rpx; box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.14); box-sizing: border-box; height: 100%; margin: 0 8rpx; overflow: hidden; padding: 32rpx 24rpx 24rpx; width: calc(100% - 16rpx); }
.sheet-main { min-height: 156rpx; position: relative; }
.sheet-content { min-width: 0; }
.sheet-title { color: #1c1c1e; font-size: 38rpx; font-weight: 600; letter-spacing: -0.5rpx; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sheet-meta-row { align-items: center; color: #636366; display: grid; font-size: 24rpx; gap: 12rpx; grid-template-columns: 28rpx minmax(0, 1fr); line-height: 1.5; margin-top: 8rpx; min-width: 0; }
.sheet-meta-row.address-row { grid-template-columns: 28rpx minmax(0, 1fr); }
.sheet-meta-icon { filter: grayscale(1); height: 28rpx; opacity: 0.68; width: 28rpx; }
.sheet-meta-text { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sheet-divider { background: rgba(60, 60, 67, 0.14); height: 1rpx; margin: 24rpx 0 16rpx; }
.sheet-actions { display: grid; gap: 16rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); min-width: 0; width: 100%; }
.sheet-action { align-items: center; border-radius: 20rpx; box-sizing: border-box; display: flex; font-size: 28rpx; font-weight: 600; gap: 8rpx; justify-content: center; margin: 0; min-height: 72rpx; min-width: 0; overflow: hidden; padding: 0 8rpx; white-space: nowrap; width: 100%; }
.sheet-action-icon { flex: 0 0 auto; height: 28rpx; width: 28rpx; }
.sheet-action.secondary-button { background: #f2f2f7; border: 0; color: #1c1c1e; }
