.map-page {
  height: 100vh;
  overflow: hidden;
  position: relative;
}

.study-map {
  height: 100vh;
  width: 100vw;
}

.top-panel {
  left: 0;
  padding: 18rpx 0 14rpx;
  position: absolute;
  right: 0;
  top: 0;
}

.category-scroll {
  white-space: nowrap;
  width: 100%;
}

.category-row {
  display: flex;
  gap: 10rpx;
  padding: 0 24rpx;
}

.category-chip {
  align-items: center;
  background: rgba(255, 255, 255, 0.64);
  border: 1rpx solid rgba(31, 35, 40, 0.08);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 40, 0.05);
  color: #8c959f;
  display: flex;
  flex: 0 0 auto;
  font-size: 23rpx;
  gap: 8rpx;
  height: 52rpx;
  line-height: 52rpx;
  margin: 0;
  min-width: 0;
  padding: 0 18rpx;
}

.category-chip.active {
  background: rgba(255, 255, 255, 0.98);
  border-color: #1677ff;
  color: #1f2328;
  font-weight: 600;
}

.category-dot {
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx rgba(31, 35, 40, 0.16);
  height: 14rpx;
  opacity: 0.35;
  width: 14rpx;
}

.category-chip.active .category-dot {
  opacity: 1;
}

.map-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  bottom: calc(118rpx + env(safe-area-inset-bottom));
  position: absolute;
  right: 20rpx;
}

.location-button {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid rgba(31, 35, 40, 0.1);
  border-radius: 12rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 35, 40, 0.16);
  display: flex;
  height: 72rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  width: 72rpx;
}

.location-glyph {
  color: #1677ff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.bottom-sheet {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 35, 40, 0.1);
  border-radius: 20rpx 20rpx 0 0;
  bottom: 0;
  box-shadow: 0 -12rpx 36rpx rgba(31, 35, 40, 0.12);
  left: 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  position: absolute;
  right: 0;
}

.sheet-topline {
  align-items: center;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}

.sheet-kicker {
  color: #1f6feb;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.favorite-button {
  background: #ffffff;
  border: 1rpx solid rgba(31, 35, 40, 0.14);
  border-radius: 999rpx;
  color: #59636e;
  font-size: 24rpx;
  line-height: 54rpx;
  margin: 0;
  padding: 0 22rpx;
}

.favorite-button.active {
  background: #fff8e6;
  border-color: #bf8700;
  color: #8a6300;
  font-weight: 700;
}

.sheet-title {
  color: #1f2328;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
}

.sheet-address,
.sheet-meta,
.sheet-summary {
  color: #59636e;
  font-size: 26rpx;
  line-height: 1.45;
  margin-top: 10rpx;
}

.sheet-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.tag {
  background: #eef4ff;
  border-radius: 999rpx;
  color: #1f6feb;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.sheet-action {
  flex: 1;
}
