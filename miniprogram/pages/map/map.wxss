.map-page {
  background: #061111;
  height: 100vh;
  overflow: hidden;
  position: relative;
}

.study-map {
  height: 100vh;
  width: 100vw;
}

.map-scrim {
  background: linear-gradient(180deg, rgba(5, 10, 11, 0.88), rgba(5, 10, 11, 0.52) 52%, rgba(5, 10, 11, 0) 100%);
  height: 240rpx;
  left: 0;
  pointer-events: none;
  position: absolute;
  right: 0;
  top: 0;
}

.custom-nav {
  align-items: center;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
}

.nav-title {
  color: #f1dfbd;
  font-family: "Songti SC", "STSong", serif;
  font-size: 39rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.2;
  text-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.6);
}

.top-panel {
  left: 0;
  padding: 18rpx 0 12rpx;
  position: absolute;
  right: 0;
}

.category-scroll {
  white-space: nowrap;
  width: 100%;
}

.category-row {
  display: flex;
  gap: 14rpx;
  padding: 0 20rpx;
}

.category-chip {
  align-items: center;
  background: rgba(18, 19, 17, 0.72);
  border: 1rpx solid rgba(190, 145, 66, 0.44);
  border-radius: 999rpx;
  color: #f2e2c5;
  display: flex;
  flex: 0 0 auto;
  font-size: 26rpx;
  font-weight: 600;
  gap: 10rpx;
  height: 56rpx;
  justify-content: center;
  line-height: 56rpx;
  margin: 0;
  max-width: none;
  min-width: 0;
  padding: 0;
}

.category-chip.active {
  background: rgba(41, 82, 48, 0.78);
  border-color: rgba(133, 205, 127, 0.7);
  color: #fff6df;
}

.category-dot {
  border-radius: 50%;
  height: 15rpx;
  opacity: 1;
  width: 15rpx;
}

.load-tip {
  background: rgba(243, 235, 220, 0.88);
  border-radius: 999rpx;
  color: #2c423a;
  font-size: 23rpx;
  left: 24rpx;
  padding: 10rpx 18rpx;
  position: absolute;
  top: 220rpx;
}

.map-actions {
  bottom: calc(470rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  position: absolute;
  right: 28rpx;
}

.location-button {
  align-items: center;
  background: rgba(88, 111, 65, 0.58);
  border: 1rpx solid rgba(230, 210, 165, 0.18);
  border-radius: 50%;
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.38);
  display: flex;
  height: 92rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  width: 92rpx;
}

.location-glyph {
  color: #fff7df;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1;
}

.bottom-sheet {
  background: linear-gradient(135deg, rgba(251, 246, 234, 0.98), rgba(232, 218, 193, 0.94));
  border: 1rpx solid rgba(232, 196, 125, 0.42);
  border-radius: 34rpx;
  bottom: calc(154rpx + env(safe-area-inset-bottom));
  box-shadow: 0 22rpx 52rpx rgba(0, 0, 0, 0.34);
  box-sizing: border-box;
  left: 18rpx;
  min-height: 364rpx;
  padding: 38rpx 32rpx 30rpx;
  position: absolute;
  right: 18rpx;
}

.sheet-main {
  display: grid;
  gap: 22rpx;
  grid-template-columns: 118rpx 1fr;
  position: relative;
}

.sheet-icon {
  align-items: center;
  border: 2rpx solid rgba(232, 196, 125, 0.4);
  border-radius: 50%;
  box-shadow: inset 0 0 28rpx rgba(0, 0, 0, 0.2);
  color: #f4dfb6;
  display: flex;
  font-size: 42rpx;
  font-weight: 800;
  height: 110rpx;
  justify-content: center;
  width: 110rpx;
}

.sheet-title {
  color: #2b2922;
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1.16;
}

.sheet-address,
.sheet-hours {
  color: #4b4237;
  font-size: 27rpx;
  line-height: 1.35;
  margin-top: 12rpx;
}

.sheet-hours {
  color: #2f5c36;
}

.sheet-distance {
  bottom: 6rpx;
  color: #6a5a43;
  font-size: 27rpx;
  position: absolute;
  right: 0;
}

.sheet-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.tag {
  background: rgba(218, 199, 165, 0.38);
  border: 1rpx solid rgba(155, 123, 75, 0.18);
  border-radius: 14rpx;
  color: #5f513d;
  font-size: 23rpx;
  padding: 7rpx 16rpx;
}

.sheet-divider {
  background: rgba(139, 111, 70, 0.28);
  height: 1rpx;
  margin: 24rpx 0 20rpx;
}

.sheet-actions {
  display: grid;
  gap: 20rpx;
  grid-template-columns: repeat(3, 1fr);
}

.sheet-action {
  background: rgba(210, 195, 170, 0.48);
  border: 1rpx solid rgba(184, 137, 77, 0.26);
  border-radius: 16rpx;
  color: #302d28;
  font-size: 30rpx;
  gap: 10rpx;
  min-height: 78rpx;
}

.sheet-action.active {
  background: rgba(184, 137, 77, 0.18);
  border-color: rgba(184, 137, 77, 0.34);
  color: #6f4b20;
}
