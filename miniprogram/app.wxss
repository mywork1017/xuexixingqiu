page {
  background: #f7f7fa;
  color: #18181b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

button {
  box-sizing: border-box;
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
}

.icon-button {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e5e2e9;
  border-radius: 12rpx;
  color: #18181b;
  display: flex;
  height: 80rpx;
  justify-content: center;
  padding: 0;
  width: 80rpx;
}

.primary-button,
.secondary-button {
  align-items: center;
  border-radius: 12rpx;
  display: flex;
  font-weight: 500;
  justify-content: center;
  line-height: 1.2;
  min-height: 80rpx;
  padding: 0 24rpx;
}

.primary-button {
  background: #7d36ec;
  border: 1rpx solid #7d36ec;
  color: #ffffff;
}

.secondary-button {
  background: #ffffff;
  border: 1rpx solid #e5e2e9;
  color: #18181b;
}
