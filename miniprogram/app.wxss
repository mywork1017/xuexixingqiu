page {
  background: #f2f2f7;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

button {
  box-sizing: border-box;
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
}

.icon-button {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #d1d1d6;
  border-radius: 20rpx;
  color: #1c1c1e;
  display: flex;
  height: 80rpx;
  justify-content: center;
  padding: 0;
  width: 80rpx;
}

.primary-button,
.secondary-button {
  align-items: center;
  border-radius: 20rpx;
  display: flex;
  font-weight: 500;
  justify-content: center;
  line-height: 1.2;
  min-height: 80rpx;
  padding: 0 24rpx;
}

.primary-button {
  background: #000000;
  border: 1rpx solid #000000;
  color: #ffffff;
}

.secondary-button {
  background: #f2f2f7;
  border: 0;
  color: #1c1c1e;
}
