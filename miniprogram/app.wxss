page {
  background: #f7f8f4;
  color: #1f2328;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

button {
  font: inherit;
}

.page {
  min-height: 100vh;
  background: #f7f8f4;
}

.icon-button {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid rgba(31, 35, 40, 0.12);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 40, 0.08);
  color: #1f2328;
  display: flex;
  height: 80rpx;
  justify-content: center;
  padding: 0;
  width: 80rpx;
}

.primary-button {
  align-items: center;
  background: #1f6feb;
  border-radius: 16rpx;
  color: #ffffff;
  display: flex;
  font-weight: 600;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
}

.secondary-button {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid rgba(31, 35, 40, 0.12);
  border-radius: 16rpx;
  color: #1f2328;
  display: flex;
  font-weight: 600;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
}
