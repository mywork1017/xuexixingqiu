page {
  background: #071112;
  color: #f4ead8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

button {
  box-sizing: border-box;
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
}

.icon-button {
  align-items: center;
  background: #fff8ea;
  border: 1rpx solid rgba(184, 137, 77, 0.18);
  border-radius: 14rpx;
  color: #102724;
  display: flex;
  height: 80rpx;
  justify-content: center;
  padding: 0;
  width: 80rpx;
}

.primary-button {
  align-items: center;
  background: linear-gradient(135deg, #0b351f, #122a1b);
  border: 1rpx solid rgba(232, 196, 125, 0.44);
  border-radius: 14rpx;
  color: #fff0d4;
  display: flex;
  font-weight: 700;
  justify-content: center;
  line-height: 1.2;
  min-height: 84rpx;
  padding: 0 24rpx;
}

.secondary-button {
  align-items: center;
  background: rgba(210, 195, 170, 0.42);
  border: 1rpx solid rgba(184, 137, 77, 0.28);
  border-radius: 14rpx;
  color: #2f3029;
  display: flex;
  font-weight: 700;
  justify-content: center;
  line-height: 1.2;
  min-height: 84rpx;
  padding: 0 24rpx;
}
